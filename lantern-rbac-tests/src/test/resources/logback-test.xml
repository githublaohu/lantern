<configuration>
    <appender name="stdout" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>%level %logger{45} - %msg%n</pattern></encoder>
    </appender>
    <root level="ERROR"><appender-ref ref="stdout"/></root>
    <logger name="com.lamp.lantern" level="WARN"/>
</configuration>
